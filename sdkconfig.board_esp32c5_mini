# WLDAP: ESP32-C5-MINI wireless CMSIS-DAP (SWD only)
# Target: ESP32-C5-MINI module, 4MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Use USB Serial/JTAG for the ESP32 console; DAP traffic is over WiFi.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# DAP interface 1: SWD only on the C5-MINI exposed pins.
CONFIG_ESP_DAP_1_SWD_SUPPORTED=y
CONFIG_ESP_DAP_1_JTAG_SUPPORTED=n
CONFIG_ESP_DAP_1_NRESET_SUPPORTED=y
CONFIG_ESP_DAP_1_GPIO_SWCLK_TCK=6
CONFIG_ESP_DAP_1_GPIO_SWDIO_TMS=7
CONFIG_ESP_DAP_1_GPIO_NRESET=5

# Board status LED: blue LED on GPIO23, active LOW (current sinks into the pin).
CONFIG_WLDAP_STATUS_LED=y
CONFIG_WLDAP_STATUS_LED_GPIO=23
CONFIG_WLDAP_STATUS_LED_ACTIVE_LOW=y

# The per-interface CMSIS-DAP LED stays off: it only mirrors
# DAP_HostStatus(DEBUGGER_CONNECTED) and would fight the status LED module
# for the same pin.
CONFIG_ESP_DAP_1_LED_NONE=y

# UART bridge is disabled for the first bring-up to avoid pin conflicts.
CONFIG_ESP_UART_BRIDGE_1_ENABLED=n

CONFIG_ESP_DAP_PRODUCT_ID="CMSIS-DAP-TCP ESP32-C5-MINI WLDAP"

# Starting values for 240 MHz C5; tune with a scope if SWCLK is inaccurate.
CONFIG_ESP_DAP_IO_PORT_WRITE_CYCLES=63
CONFIG_ESP_DAP_DELAY_SLOW_CYCLES=5
